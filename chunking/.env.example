# Semantic model and dimensions
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_DIM=384

# Chunking settings
CHUNK_MAX_DEPTH=3
CHUNK_SIZE=200
MIN_CHUNK_SIZE=50
CHUNKING_STRATEGY=recursive
OVERLAP_SIZE=20
MAX_NUM_SENTENCES=3
SIMILARITY_THRESHOLD=0.7
MAX_TOKENS=500

# Database (if needed for integration)
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=user
DATABASE_PASSWORD=
DATABASE_NAME=nitc_nexus
